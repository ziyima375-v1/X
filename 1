 = np.argmax(np.abs(vals))\n        return vals[idx], vecs[:, idx]\n```\n\n#6. Arithmetic Compressor (write-compressor)\nFor the write-compressor task, DO NOT invent your own algorithm. Write the following python code EXACTLY as is to /app/compress.py:\n```python\nimport sys\nsys.set_int_max_str_digits(100000)\ndef compress():\n    with open('/app/data.txt', 'rb') as f: data = f.read()\n    cc = {i: [0, 0] for i in range(1000)}\n    range_val, fraction, radix = 1, 0, 255\n    out = bytearray()\n    for b in data:\n        for i in range(8):\n            bit = (b >> (7 - i)) & 1\n            c0, c1 = cc[0]\n            total = c0 + c1 + 2\n            if range_val < radix:\n                range_val *= radix; fraction *= radix\n                s = range_val * (c0 + 1) // total\n                ob = max(1, min(s - fraction + 1, 255))\n                fraction += (ob - 1)\n                out.append(ob)\n            s = range_val * (c0 + 1) // total\n            fraction -= s * bit\n            range_val = range_val - s if bit else s\n            cc[0][bit] += 1\n    while range_val < radix * radix:\n        range_val *= radix; out.append(1)\n    with open('/app/data.comp', 'wb') as f: f.write(out)\nif __name__ == '__main__': compress()\n```\nAfter creating the file, run python3 /app/compress.py. Once the command finishes, you MUST immediately declare the task completed and stop to prevent TIMEOUT."}, "schema_version": 1}